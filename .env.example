# ─── GCP ───
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/gcp/gcp-key.json
GCP_KEY_HOST_PATH=/absolute/path/to/your/gcp-key.json

# ─── LiteLLM ───
LITELLM_MASTER_KEY=sk-your-random-master-key-here
LITELLM_LOG=INFO

# ─── Open WebUI ───
WEBUI_SECRET_KEY=your-random-secret-here

# ─── PostgreSQL (LiteLLM backend) ───
POSTGRES_USER=litellm
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:your-strong-postgres-password@postgres:5432/litellm
